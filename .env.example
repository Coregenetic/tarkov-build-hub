# PostgreSQL-Verbindung (nur Platzhalter – echte Werte gehören in .env, nie ins Repo)
DATABASE_URL=postgres://tbh:CHANGE_ME@127.0.0.1:5432/tbh

# Basis-URL der Datenquelle (Community-API von tarkov.dev, nicht offiziell)
TARKOV_DEV_BASE_URL=https://json.tarkov.dev

# Öffentliche Adresse der Seite (ohne Pfad). Bestimmt Redirect-URL und sichere Cookies (https).
PUBLIC_BASE_URL=http://localhost:3000

# Twitch-Application NUR für den Build Hub (dev.twitch.tv/console/apps)
# Redirect-URL dort eintragen: <PUBLIC_BASE_URL>/auth/twitch/callback
TWITCH_CLIENT_ID=CHANGE_ME
TWITCH_CLIENT_SECRET=CHANGE_ME

# Zufälliger Schlüssel, mindestens 32 Zeichen, z. B.: openssl rand -base64 48
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Gültigkeit einer Anmeldung in Tagen (verlängert sich bei Nutzung)
SESSION_TTL_DAYS=30
