# Tägliche Datenbanksicherung aus dem Container tbh-postgres nach /opt/tarkov-build-hub/backups (14 Tage).
# Läuft als root, weil nur root den Docker-Container ansprechen darf.
[Unit]
Description=Tarkov Build Hub (Datenbanksicherung)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/opt/tarkov-build-hub/current/deploy/backup.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/tarkov-build-hub/backups
