# EIGENE Caddy-Instanz nur für den Build Hub – zusätzlich zu den bestehenden Caddy-Instanzen.
# Eigenes Programm, eigener Nutzer, eigene Konfiguration, eigene Zertifikate, Admin-Schnittstelle aus.
# Berührt keine bestehende Caddy-Konfiguration und keinen bestehenden Dienst.
[Unit]
Description=Tarkov Build Hub (eigene Caddy-Instanz)
After=network-online.target tbh-web.service
Wants=network-online.target

[Service]
Type=notify
User=tbh-caddy
Group=tbh-caddy
EnvironmentFile=/opt/tarkov-build-hub/caddy/caddy.env
Environment=XDG_DATA_HOME=/opt/tarkov-build-hub/caddy/data
Environment=XDG_CONFIG_HOME=/opt/tarkov-build-hub/caddy/config
ExecStart=/opt/tarkov-build-hub/caddy/bin/caddy run --environ=false --config /opt/tarkov-build-hub/caddy/Caddyfile --adapter caddyfile
ExecReload=/bin/kill -USR1 $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/opt/tarkov-build-hub/caddy/data /opt/tarkov-build-hub/caddy/config /opt/tarkov-build-hub/caddy/logs

[Install]
WantedBy=multi-user.target
