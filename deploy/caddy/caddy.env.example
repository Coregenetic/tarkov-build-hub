# Domain des Build Hub (DNS A/AAAA muss auf TBH_BIND zeigen)
TBH_DOMAIN=builds.example.de
# Adresse, auf der NUR diese Caddy-Instanz lauscht (z. B. zusätzliche IPv4 des Servers).
# Darf nicht von einer bestehenden Instanz belegt sein – install.sh prüft das.
TBH_BIND=203.0.113.10
TBH_HTTP_PORT=80
TBH_HTTPS_PORT=443
TBH_ACME_EMAIL=admin@example.de
