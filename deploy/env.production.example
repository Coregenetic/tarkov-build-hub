# Build Hub – Produktionsumgebung. Liegt als /opt/tarkov-build-hub/shared/.env (nur Nutzer tbh, chmod 600).
# Werte ohne Anführungszeichen und ohne Leerzeichen.

# Eigene Datenbank und eigener Datenbanknutzer nur für den Build Hub
DATABASE_URL=postgres://tbh:CHANGE_ME@127.0.0.1:5432/tbh

# Öffentliche Adresse (mit https). Bestimmt Twitch-Rückleitung und sichere Cookies.
PUBLIC_BASE_URL=https://builds.example.de

# Twitch-Application nur für den Build Hub – wird ganz zum Schluss eingerichtet.
# Redirect-URL dort: <PUBLIC_BASE_URL>/auth/twitch/callback
# Solange CHANGE_ME drinsteht, ist der Login deaktiviert, die Seite läuft trotzdem.
TWITCH_CLIENT_ID=CHANGE_ME
TWITCH_CLIENT_SECRET=CHANGE_ME

# Zufallsschlüssel, mindestens 32 Zeichen: openssl rand -base64 48
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

SESSION_TTL_DAYS=30
TARKOV_DEV_BASE_URL=https://json.tarkov.dev
